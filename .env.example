# =============================================================================
# Eau de Confianza — variables de entorno
#
# Copia este archivo a .env.local para desarrollo. En Vercel se cargan en
# Settings → Environment Variables.
#
# QUÉ CONSUME CADA UNA, HOY:
#   · CONCURSO_*   lib/concurso.ts → la portada, el formulario y las bases.
#   · NEXT_PUBLIC_CORREO_DATOS   lib/contacto.ts → formulario, /listo y bases.
#   · SUPABASE_*   POST /api/inscripcion (alta) y el cron.
#   · RESEND_* y CRON_SECRET   GET /api/cron/email (drenaje de la cola).
#   · TURNSTILE_*  todavía nada: el control de abuso no está implementado.
#
# Lo único que falta por construir es el webhook de rebotes de Resend. El flujo
# público y el panel de administración (/admin) están completos.
#
# REGLA: lo que empieza con NEXT_PUBLIC_ se compila dentro del bundle que
# descarga el teléfono de cualquier persona en el mall. Una clave secreta ahí
# queda publicada, y no hay forma de retirarla salvo rotarla.
# =============================================================================


# #############################################################################
#
#   BLOQUE A — LO INDISPENSABLE (6 variables)
#
#   Con esto la activación funciona de punta a punta. Nada más es obligatorio.
#
# #############################################################################


# -----------------------------------------------------------------------------
# Supabase (3)
#
# Project Settings → API Keys. Conviene un proyecto distinto para preview: un
# despliegue de rama contra la base real mete inscripciones de prueba en el
# sorteo de verdad.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publicable (antes "anon"). Pública por diseño: lo único que autoriza es
# invocar public.crear_inscripcion, porque RLS está encendida sin políticas y
# el resto de las funciones tiene el EXECUTE revocado para anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clave secreta (antes "service_role"). SALTA RLS POR COMPLETO. Solo en el
# servidor y solo después de verificar la sesión en el mismo handler. La usan
# el drenaje del cron y el panel de administración.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Resend (2)
#
# El dominio del remitente necesita SPF, DKIM y DMARC verificados ANTES de la
# primera prueba de envío: si se manda sin eso, los correos entran a spam y la
# reputación del dominio arranca dañada.
# -----------------------------------------------------------------------------

RESEND_API_KEY=re-xxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Eau de Confianza <no-reply@betanopromo.cl>"


# -----------------------------------------------------------------------------
# Cron del drenaje de la cola (1)
#
# No es una cuenta ni un servicio: es un string que generas tú.
#
# Ningún correo se envía dentro del request de inscripción —si Resend tarda, la
# persona ve el spinner de más, y si Resend falla se pierde la inscripción
# entera por un correo que se podía reintentar—. Se encola, y un cron de Vercel
# vacía la cola por lotes.
#
# Ese cron es una URL pública: /api/cron/email. Sin secreto compartido,
# cualquiera que la adivine puede dispararla en bucle. Vercel manda
# `Authorization: Bearer $CRON_SECRET` y el handler lo compara.
#
#   openssl rand -base64 32
# -----------------------------------------------------------------------------

CRON_SECRET=


# #############################################################################
#
#   BLOQUE B — OPCIONALES
#
#   Nada de acá bloquea el lanzamiento, salvo donde se diga lo contrario.
#   Cada una explica qué se gana y qué se pierde si no está.
#
# #############################################################################


# -----------------------------------------------------------------------------
# Correo del responsable de datos  ·  SÍ BLOQUEA PRODUCCIÓN
#
# No es un servicio: es una casilla que ya tengas. La Ley 21.719 obliga a
# atender por esta vía las solicitudes de acceso, rectificación y eliminación,
# así que tiene que ser una dirección que alguien lea de verdad.
#
# Hoy lib/contacto.ts trae datos@example.com quemado en el código, y
# example.com está reservado por la RFC 2606 justamente para que no exista.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_CORREO_DATOS=


# -----------------------------------------------------------------------------
# Casilla de respuesta de los correos
#
# A dónde llega el correo de quien le da "responder" a la confirmación. Si no
# la pones, esas respuestas caen en un buzón no-reply que nadie lee.
# -----------------------------------------------------------------------------

RESEND_REPLY_TO=antonio.capra@agenciavs.cl


# -----------------------------------------------------------------------------
# Webhook de rebotes de Resend
#
# Resend avisa cuándo un correo rebotó o fue marcado como spam. El esquema ya
# trae la función que lo registra (registrar_evento_email) y excluye esas filas
# del sorteo.
#
# SI NO LO PONES: funciona igual, pero un ganador con el correo mal escrito
# nunca se entera de que ganó y el premio queda sin entregar con el sorteo ya
# hecho. Además se sigue enviando a direcciones muertas y la reputación del
# dominio se deteriora sola.
#
# Resend → Webhooks → Signing Secret. Verificar la firma no es opcional: sin
# ella cualquiera puede postear "bounced" y sacar del sorteo a quien quiera.
# -----------------------------------------------------------------------------

RESEND_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Cloudflare Turnstile
#
# ES GRATIS y no necesitas mover el DNS a Cloudflare. El plan gratuito cubre
# 1.000.000 de validaciones al mes; basta una cuenta gratuita para sacar las
# dos claves. Es un captcha, pero invisible: la persona no ve nada.
#
# SI NO LO PONES: funciona igual. Los índices únicos de la base ya impiden que
# la misma persona entre dos veces —por RUT y por correo normalizados—, que es
# la defensa que de verdad protege la integridad del sorteo. Turnstile suma
# contra otra cosa: un script que inserte miles de RUT válidos distintos para
# inflar sus probabilidades.
#
# Recomendación: lanza sin Turnstile, mira el volumen real los primeros días y
# súmalo solo si aparece tráfico raro. Se agrega después sin migración.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Fechas del concurso
#
# PARA QUÉ SIRVEN: que el formulario deje de aceptar inscripciones solo por
# haber pasado la fecha de cierre, sin que nadie apague nada a mano a las
# 23:59; y que mover esa fecha —que en una activación pasa siempre— sea
# cambiar un campo en Vercel en vez de editar código, recompilar y redesplegar.
#
# SI NO LAS PONES: se escriben como constantes en el código. Funciona igual;
# cada cambio de fecha cuesta un despliegue.
#
# Van en ISO 8601 con offset explícito. Chile cambia de huso, y escribir el
# offset evita que el cierre se corra una hora justo el fin de semana del
# cambio.
#
# Confirmadas por el cliente: viernes 21 de agosto de 2026 a las 05:00 y
# domingo 23 de agosto de 2026 a las 23:00, hora de Santiago. En agosto Chile
# está en horario de invierno, que es -04:00.
# -----------------------------------------------------------------------------

CONCURSO_INICIO=2026-08-21T05:00:00-04:00
CONCURSO_CIERRE=2026-08-23T23:00:00-04:00
CONCURSO_TZ=America/Santiago


# -----------------------------------------------------------------------------
# URL del sitio
#
# El origen absoluto del sitio. Un correo se abre FUERA del sitio, así que una
# ruta como /email/iso-96.png no resuelve contra nada: sin esta variable las
# plantillas omiten el isotipo y el lockup por completo.
#
# Puedes dejarla vacía sin romper nada. Si no está, se usa
# VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola y apunta al dominio de
# producción. Solo hace falta ponerla a mano si el sitio se sirve desde un
# dominio propio distinto del de Vercel.
#
# Sin ninguna de las dos, los correos salen sin imágenes: se leen perfectamente
# —el texto no depende de ellas— pero pierden la marca.
#
# No uses VERCEL_URL: cambia en cada despliegue, y un correo enviado hoy se abre
# dentro de seis meses.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=
